# Generated reports (Plotly HTML, CSV, Markdown tables) are not
# hand-written source; exclude them from GitHub's language statistics so
# the repo reads as the Python/TypeScript project it is.
# reports/README.md is hand-written and deliberately not matched here.
reports/*.html linguist-generated=true
reports/*.csv linguist-generated=true
reports/*.json linguist-generated=true
reports/model_comparison.md linguist-generated=true

# Model files must never get line-ending conversion: LightGBM aborts on CRLF.
backend/models/* -text
*.onnx binary
